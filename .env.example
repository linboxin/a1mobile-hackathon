# A1 Mobile credentials. Copy to .env; never commit the real values.
# Team key: shown on your team page at hack.a1mobile.com
A1_TEAM_KEY=team_replace_me
# The number you claimed via /api/numbers/claim
A1_PHONE_NUMBER=+1replace_me

# Local demo server
PORT=3000

# Public HTTPS URL of the tunnel in front of the local server
# (printed by `npm run tunnel`; changes on every tunnel restart)
PUBLIC_BASE_URL=https://replace-me.trycloudflare.com
